# bell throws exceptions in several places - ESP-IDF C++ builds have
# exceptions off by default.
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Default 2MB flash + factory partition can't fit this binary (~1.5MB).
# 4MB matches common ESP32-S3 boards; lower it via menuconfig if your
# actual chip has less.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Dynamic frequency scaling + automatic light sleep, so the clock can
# drop when idle instead of sitting at max frequency always.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
