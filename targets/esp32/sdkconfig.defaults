# bell throws exceptions in several places - ESP-IDF C++ builds have
# exceptions off by default.
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Default 2MB flash + factory partition can't fit this binary (~1.5MB).
# 4MB matches common ESP32-S3 boards; lower it via menuconfig if your
# actual chip has less.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Dynamic frequency scaling + automatic light sleep: idle most of the
# time between chunks, so let the clock drop then instead of sitting at
# max frequency around the clock. A pm lock (see main.cpp) pins it back
# to max only while frames are actually going to the DAC.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
