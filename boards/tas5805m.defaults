# ESP32 with a TAS5805M amplifier: I2S for audio, I2C for its registers.
CONFIG_SNAPCLIENT_I2S_MCLK_GPIO=0
CONFIG_SNAPCLIENT_I2S_BCLK_GPIO=26
CONFIG_SNAPCLIENT_I2S_WS_GPIO=25
CONFIG_SNAPCLIENT_I2S_DOUT_GPIO=22
CONFIG_SNAPCLIENT_DAC_I2C_SDA_GPIO=21
CONFIG_SNAPCLIENT_DAC_I2C_SCL_GPIO=27
CONFIG_SNAPCLIENT_DAC_I2C_ADDR=0x2D
