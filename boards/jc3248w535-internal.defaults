# Guition JC3248W535 (ESP32-S3, 16MB flash) with its onboard NS4168.
CONFIG_SNAPCLIENT_I2S_MCLK_GPIO=0
CONFIG_SNAPCLIENT_I2S_BCLK_GPIO=42
CONFIG_SNAPCLIENT_I2S_WS_GPIO=2
CONFIG_SNAPCLIENT_I2S_DOUT_GPIO=41
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SNAPCLIENT_I2S_DOWNMIX_MONO=y
